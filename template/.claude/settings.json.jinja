{% if os == 'windows' -%}
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%CLAUDE_PROJECT_DIR%\\scripts\\hooks\\guard-writes.ps1\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%CLAUDE_PROJECT_DIR%\\scripts\\hooks\\stop-gate.ps1\"", "timeout": 600 }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./scripts/task.ps1:*)",
      "Bash(./scripts/check.ps1)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  }
}
{%- else -%}
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-writes.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop-gate.sh", "timeout": 600 }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./scripts/task.sh:*)",
      "Bash(./scripts/check.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  }
}
{%- endif %}
